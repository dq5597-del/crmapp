# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://你的project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon_key
NEXT_PUBLIC_APP_URL=https://你的正式網域

# 一鍵完整備份時使用（設好後雙擊 backup-system.bat 會連資料庫一起備份）
CRM_DATABASE_BACKUP_URL=https://你的CRM網址/api/backup

# Supabase service role（av-shop 發佈後回寫用，勿外流）
SUPABASE_SERVICE_ROLE_KEY=你的service_role_key

# 排程提醒（至少 32 字元隨機字串）與郵件
CRON_SECRET=請自訂一組長隨機字串
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
FROM_EMAIL=system@你的網域
BOSS_EMAIL=主管信箱

# Web Push（私鑰不可使用 NEXT_PUBLIC_ 前綴）
VAPID_PRIVATE_KEY=你的VAPID私鑰

# Anthropic（名片 OCR 用）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# av-shop.com（WooCommerce）產品同步
# 金鑰：WooCommerce → 設定 → 進階 → REST API 金鑰 →「CRM 產品同步」
# ============================================================
WC_STORE_URL=https://av-shop.com
WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WordPress 媒體庫上傳（使用者 → 個人資料 → 應用程式密碼）
# 僅供伺服器端 API 使用，不可加 NEXT_PUBLIC_ 前綴
WP_MEDIA_USERNAME=wordpress_admin_username
WP_MEDIA_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 網站發佈後回寫 CRM 的驗證字串（自訂，av-shop 端要填一樣的）
WC_WEBHOOK_SECRET=請自訂一組長字串

# ============================================================
# Google 試算表產品雙向同步（僅系統管理員總表）
# ============================================================
GOOGLE_PRODUCT_SHEET_ID=你的Google試算表ID
GOOGLE_PRODUCT_SYNC_SECRET=請自訂至少24字元的獨立隨機密鑰
NEXT_PUBLIC_GOOGLE_PRODUCT_SHEET_URL=https://docs.google.com/spreadsheets/d/你的Google試算表ID/edit

# Google Drive：服務帳號或 OAuth 二擇一；有需要才設定
GDRIVE_FOLDER_ID=根資料夾ID
GOOGLE_SA_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_OAUTH_CLIENT_ID=你的OAuthClientID
GOOGLE_OAUTH_CLIENT_SECRET=你的OAuthClientSecret
GOOGLE_OAUTH_REFRESH_TOKEN=你的RefreshToken

# 交通部 TDX（火車資訊；未設定時功能會顯示設定提示）
TDX_CLIENT_ID=你的TDXClientID
TDX_CLIENT_SECRET=你的TDXClientSecret
